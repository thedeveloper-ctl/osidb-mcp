# Copy to .env and fill in. Never commit .env.

OSIDB_BASE_URL=https://osidb.example.com
OSIDB_AUTH=kerberos
# OSIDB_USERNAME=
# OSIDB_PASSWORD=
OSIDB_VERIFY_SSL=true

# readonly (default) or readwrite
OSIDB_MCP_ACCESS_MODE=readonly

# full (default), lifecycle, or core
OSIDB_MCP_PROFILE=full

# Exploits tools are on by default only for full.
# OSIDB_MCP_ENABLE_EXPLOITS=true

# Optional. Registers AEGIS tools when set.
# AEGIS_URL=

# Optional Jira (internal comments and OSIDB Jira authentication)
# JIRA_URL=
# JIRA_ACCESS_TOKEN=
# JIRA_API_EMAIL=
